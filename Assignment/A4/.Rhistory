knitr::opts_chunk$set(echo = TRUE)
library(MASS)
# Load the Boston dataset from the MASS library
data(Boston)
n <- nrow(Boston)
p <- ncol(Boston)
X <- cbind(1, Boston[, -p])
# Load necessary libraries
library(rjags)
library(coda)
# Define the data for the model
data_list <- list(Y = Boston$medv, n = n, p = p, X = X)
# Define the JAGS model for part a
model_string_a <- "
model{
# Likelihood
for(i in 1:n){
Y[i] ~ dnorm(inprod(X[i, ], beta[1:p]), tau)
}
# Priors
beta[1] ~ dnorm(0,1e-4)
for(i in 2:p){
beta[i] ~ dnorm(0, 1e-4)
}
tau ~ dgamma(0.1, 0.1)
sigma2 <- 1 / tau
}"
# Compile the JAGS model
model_a <- jags.model(textConnection(model_string_a), data = data_list, quiet = TRUE)
# Burn-in
update(model_a, 5e3, progress.bar = 'none')
# Sampling from the posterior distribution
params <- c('beta')
samples_a <- coda.samples(model_a,
variable.names = params,
n.iter = 2e4, progress.bar = 'none')
# Summarize the posterior samples
summary(samples_a)
# Plot trace and density for beta[1] and beta[2]
par(mfrow=c(2,1))
plot(samples_a[[1]][, "beta[1]"], type="l", main="Trace Plot for beta[1]")
plot(samples_a[[1]][, "beta[2]"], type="l", main="Trace Plot for beta[2]")
par(mfrow=c(2,1))
densplot(samples_a[[1]][, "beta[1]"], main="Density Plot for beta[1]")
densplot(samples_a[[1]][, "beta[2]"], main="Density Plot for beta[2]")
# Part b - Fit linear regression using lm
fit_least_sq <- lm(medv~., data = Boston)
summary(fit_least_sq)
# Part c - Define the JAGS model for part c
model_string_c <- "
model{
# Likelihood
for(i in 1:n){
Y[i] ~ dnorm(inprod(X[i, ], beta[]), tau)
}
# Priors
beta[1] ~ ddexp(0,1e-4)
for(i in 2:p){
beta[i] ~ ddexp(0, 1e-4)
}
tau ~ dgamma(0.1, 0.1)
sigma2 <- 1 / tau
}"
# Compile the JAGS model for part c
model_c <- jags.model(textConnection(model_string_c), data = data_list, quiet = TRUE)
# Burn-in
update(model_c, 5e3, progress.bar = 'none')
# Sampling from the posterior distribution for part c
samples_c <- coda.samples(model_c,
variable.names = params,
n.iter = 2e4, progress.bar = 'none')
# Summarize the posterior samples for part c
summary(samples_c)
# Predict using the last 6 observations
posterior_predictive <- matrix(NA, nrow = 6, ncol = 2)
for (i in 1:6) {
posterior_predictive[i, ] <- predict(model, newdata = data_last)$sim[1, i]
}
# Predict using the last 6 observations
posterior_predictive <- matrix(NA, nrow = 6, ncol = 2)
for (i in 1:6) {
posterior_predictive[i, ] <- predict(model, newdata = data_last)$sim[1, i]
}
