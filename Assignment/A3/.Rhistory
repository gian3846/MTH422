n<-3
Y<-c(12,10,22)
sigma<-diag(3,3,10)
library(mvtnorm)
density <- function (x) {
out <- 1
for (i in 1:length(Y)){
out <- out * dnorm( Y[i], mean = x, sd = sigma[i] )
}
return (out)
}
NormConst<- integrate(posterior, -Inf, Inf)$value
NormConst<- integrate(density, -Inf, Inf)$value
NormConst
#Q2
n<-3
Y<-c(12,10,22)
sigma<-diag(3,3,10)
library(mvtnorm)
density <- function (x) {
out <- 1
for (i in 1:length(Y)){
out <- out * dnorm( Y[i], mean = x, sd = sigma[i] )*1e2
}
return (out)
}
NormConst<- integrate(density, -Inf, Inf)$value
NormConst
density <- function (x) {
out <- 1
for (i in 1:length(Y)){
out <- out * dnorm( x, mean = Y[i], sd = sigma[i] )
}
return (out)
}
NormConst<- integrate(density, -Inf, Inf)$value
NormConst
