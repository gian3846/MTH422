theta.update <- function(n,Y,Q,N,m)
{
theta<-rbeta(n,Y+exp(m)*Q,N-Y+exp(m)*(1-Q))
return(theta)
}
m.update <- function()
{
m<-rnorm(1,0,10)
return(m)
}
