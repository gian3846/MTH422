model_string <- textConnection("model{
# Likelihood
for(i in 1:n){
Y[i] ~ dbinom(N[i],theta[i])
}
# Priors
for(i in 1:n){
theta[i] ~ dbeta(exp(m)*Q[i],exp(m)*(1-Q[i]))
}
m ~ dnorm(0,10)
}")
model <- jags.model(model_string, data = data,
n.chains = 2, quiet = TRUE)
